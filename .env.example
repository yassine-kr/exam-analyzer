# Copy to .env and fill in your own values
AWS_REGION=eu-central-1
S3_BUCKET=exam-analyzer-<your-name>
DYNAMODB_TABLE=exam-documents

# Step 4 (optional): sign-in with Amazon Cognito. Leave empty to disable.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Any long random string (generate one with: openssl rand -hex 32)
SESSION_SECRET=

# Real domain (optional): e.g. exam.example.com, then run ./get-certificate.sh (README step 5)
DOMAIN=
LETSENCRYPT_EMAIL=
