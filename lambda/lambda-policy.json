{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadedDocuments",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/uploads/*"
    },
    {
      "Sid": "UpdateDocumentMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/TABLE_NAME"
    },
    {
      "Sid": "CallClaudeOnBedrock",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock-mantle:CreateInference"
      ],
      "Resource": "*"
    }
  ]
}
